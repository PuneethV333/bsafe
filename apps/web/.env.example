# Firebase client config — used ONLY for auth. The app runs locally without these
# (firebase stays uninitialized); populate them to enable Phase 2 auth.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# API origin for production. Leave empty for dev — the client then stays
# same-origin and the Vite proxy forwards /api and /socket.io to :3000.
# In production point this at the deployed API (e.g. https://bsafe-api.onrender.com).
VITE_API_URL=