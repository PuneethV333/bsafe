generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String               @id @default(uuid())
  firebaseUid String               @unique @map("firebase_uid")
  name        String
  email       String?              @unique
  phone       String?              @unique
  isAdmin     Boolean              @default(false) @map("is_admin")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  contacts    EmergencyContact[]
  alerts      Alert[]
}

model EmergencyContact {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  email        String?
  relationship String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  notificationDeliveries NotificationDelivery[]

  @@unique([userId, phone])
  @@unique([userId, email])
  @@index([userId])
}

enum AlertStatus {
  sent
  acknowledged
  resolved
}

model Alert {
  id            String          @id @default(uuid())
  userId        String          @map("user_id")
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        AlertStatus     @default(sent)
  trackingToken String          @unique @map("tracking_token") @default(uuid())
  triggeredAt   DateTime        @default(now()) @map("triggered_at")
  resolvedAt    DateTime?       @map("resolved_at")
  lastLocation  AlertLocation?  @relation("LastLocation", fields: [lastLocationId], references: [id])
  lastLocationId String?        @unique @map("last_location_id")
  locations     AlertLocation[] @relation("AlertLocations")
  activityLogs  ActivityLog[]
  notificationDeliveries NotificationDelivery[]

  @@index([userId])
  @@index([status])
}

model AlertLocation {
  id         String   @id @default(uuid())
  alertId    String   @map("alert_id")
  alert      Alert    @relation("AlertLocations", fields: [alertId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  accuracy   Float?
  recordedAt DateTime @default(now()) @map("recorded_at")
  lastLocationOf Alert? @relation("LastLocation")

  @@index([alertId, recordedAt])
}

model ActivityLog {
  id        String   @id @default(uuid())
  alertId   String   @map("alert_id")
  alert     Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  eventType String   @map("event_type")
  actor     String?
  timestamp DateTime @default(now())

  @@index([alertId])
}

enum NotificationChannel {
  sms
  email
}

enum NotificationStatus {
  queued
  sent
  failed
}

model NotificationDelivery {
  id        String              @id @default(uuid())
  alertId   String              @map("alert_id")
  alert     Alert               @relation(fields: [alertId], references: [id], onDelete: Cascade)
  contactId String              @map("contact_id")
  contact   EmergencyContact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  status    NotificationStatus  @default(queued)
  attempts  Int                @default(0)
  lastError String?            @map("last_error")
  sentAt    DateTime?          @map("sent_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@unique([alertId, contactId, channel])
  @@index([alertId])
  @@index([status])
}