# Server
PORT=3000

# PostgreSQL — docker-compose maps host 5434 -> container 5432
DATABASE_URL="postgresql://bsafe:bsafe@localhost:5434/bsafe?schema=public"

# Redis (localhost per project decision)
REDIS_HOST=localhost
REDIS_PORT=6379

# Firebase Admin SDK — used by the FirebaseAuthGuard (Phase 2)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Twilio (Phase 6)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# SendGrid (Phase 6)
SENDGRID_API_KEY=
