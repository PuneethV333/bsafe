# Server
PORT=3000

# PostgreSQL — docker-compose maps host 5434 -> container 5432
DATABASE_URL="postgresql://bsafe:bsafe@localhost:5434/bsafe?schema=public"

# Redis — either a full URL (e.g. Upstash rediss://…:6380) or the host/port pair.
# Required. Redis connection URL (e.g. Upstash rediss://endpoint:port). No fallback.

REDIS_URL=
# CORS — comma-separated list of allowed web origins (e.g. https://bsafe.vercel.app).
# Also applied to the Socket.IO gateway handshake.
CORS_ORIGINS=http://localhost:5173

# Firebase Admin SDK — used by the FirebaseAuthGuard (Phase 2)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin (Phase 8) — comma-separated emails granted isAdmin on auth sync
ADMIN_EMAILS=

# Twilio (Phase 6)
# Trial accounts work without a Messaging Service: set TWILIO_PHONE_NUMBER to a
# Twilio trial number in E.164 format (e.g. +14155238885). On a trial account,
# recipients must also be Verified Caller IDs or SMS fails (error 21608).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Notifications (Phase 6)
# Base URL used to build the tokenized tracking link sent to contacts (/track/:token)
WEB_BASE_URL=http://localhost:5173
# When true (default), SMS/email are logged and marked "sent" without any provider call.
# Set to false in staging/production to send real messages.
NOTIFICATIONS_DRY_RUN=true
